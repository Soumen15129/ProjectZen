# Secrets
.env
middleware/.env

# CLIENT DATA — never commit. These hold real client source documents,
# generated deliverables and decks. They stay on each developer's desktop
# only. Adding anything here to git would publish client material.
Input/
REF FILE/
GENERATED OUTPUT/
CLAUDE DESKTOP GENERATED/
PRESENTATION/
LOG/

# Generation traces: contain prompt/document content and account emails.
storage/runlogs/

# Local scratch
before.txt
c

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Runtime data (recreated automatically on startup / stored on Fly volume)
storage/documents.db
storage/document_store/

# Claude Agent SDK scratch cwd (llm_client.py) — sandboxes the CLI, never
# holds anything worth keeping
middleware/.llm_scratch/

# Stray files from a malformed pip install command
middleware/=*

# Saved webpage clutter (browser "Save As", not part of the app)
ProjectZen — Agent Playbook_files/
ProjectZen Document — Agent Playbook.html

# Claude Code local (personal) settings
.claude/settings.local.json

# Editor/OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Installer build artefacts. middleware/seed holds CLIENT reference documents
# (35 MB) staged for bundling — it is generated by installer/build.ps1 from
# storage/, so it must never enter git history.
middleware/seed/
installer/payload/
installer/python/
installer/wheels/
installer/dist/
installer/.tmp/
